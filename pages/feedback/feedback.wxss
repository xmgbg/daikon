.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9f0 0%, #fff5e6 40%, #ffe8d6 100%);
  padding: 40rpx 28rpx 140rpx;
  position: relative;
  overflow-x: hidden;
}

.info-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 30rpx 30rpx;
  position: relative;
  z-index: 10;
}

.info-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.22);
  animation: breathe 3s ease-in-out infinite;
}

.info-title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: bold;
  color: #2c2c2c;
  letter-spacing: 8rpx;
  line-height: 1.2;
}

.feedback-content {
  padding: 0;
}

.tips-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 20rpx;
  text-align: center;
}

.tips-list {
  line-height: 1.8;
}

.tips-item {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.input-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.suggestion-input {
  width: 100%;
  min-height: 300rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c5a 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 5rpx 15rpx rgba(255, 107, 53, 0.3);
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.footer-decoration {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 0;
}

.decoration-item {
  font-size: 40rpx;
  animation: twinkle 2s infinite;
}

.decoration-item:nth-child(2) {
  animation-delay: 0.5s;
}

.decoration-item:nth-child(3) {
  animation-delay: 1s;
}

@keyframes twinkle {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.6;
    transform: scale(1.1);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}
