.splash-container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #fff9f0 0%, #fff5e6 50%, #ffe8d6 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, #ff6b35 0%, transparent 70%);
  top: -100rpx;
  right: -100rpx;
  animation: float 8s ease-in-out infinite;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, #ff8c42 0%, transparent 70%);
  bottom: 100rpx;
  left: -80rpx;
  animation: float 6s ease-in-out infinite reverse;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, #ffa556 0%, transparent 70%);
  top: 40%;
  right: 10%;
  animation: float 10s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-30rpx) scale(1.05);
  }
}

.content-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  padding: 0 60rpx;
  animation: fadeInUp 1s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.logo-section {
  margin-bottom: 40rpx;
  animation: breathe 3s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.logo-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  box-shadow: 0 20rpx 60rpx rgba(255, 107, 53, 0.3);
}

.brand-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #2c2c2c;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
  text-align: center;
  font-family: 'STKaiti', 'KaiTi', serif;
}

.slogan {
  font-size: 28rpx;
  color: #ff6b35;
  margin-bottom: 30rpx;
  letter-spacing: 6rpx;
  font-weight: 500;
}

.divider {
  width: 120rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #ff6b35 50%, transparent 100%);
  margin-bottom: 30rpx;
  border-radius: 2rpx;
}

.description {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  line-height: 1.8;
  margin-bottom: 80rpx;
  letter-spacing: 2rpx;
}

.enter-btn {
  width: 480rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 53, 0.4);
  transition: all 0.3s ease;
  border: none;
  position: relative;
  overflow: hidden;
}

.enter-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.enter-btn:active::before {
  left: 100%;
}

.enter-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.btn-icon {
  font-size: 32rpx;
  color: #fff;
  margin-left: 16rpx;
  transition: transform 0.3s ease;
}

.enter-btn:active .btn-icon {
  transform: translateX(8rpx);
}

.footer {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 10;
}

.copyright {
  font-size: 22rpx;
  color: #999;
  letter-spacing: 2rpx;
}