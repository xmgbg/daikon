.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background-color: #faf5ef;
}

.product-card {
  width: 90%;
  margin: 0 auto;
  background-color: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  animation: cardBreathe 3s ease-in-out infinite;
}

@keyframes cardBreathe {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  }
  50% {
    transform: scale(1.01);
    box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  }
}

.product-main-image {
  width: 100%;
  height: 700rpx;
  display: block;
}

.product-info {
  padding: 40rpx;
  box-sizing: border-box;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.product-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}
