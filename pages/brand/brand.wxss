/* ==================== 容器 ==================== */

.brand-container {
  width: 100%;
  height: 100vh;
  background-color: #fff8f0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ==================== 导航栏 ==================== */

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background-color: #fff8f0;
  flex-shrink: 0;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 52rpx;
  color: #6d4f3e;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  color: #6d4f3e;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 60rpx;
}

/* ==================== Tab 栏 ==================== */

.tab-bar {
  display: flex;
  justify-content: space-around;
  padding: 0 30rpx;
  background-color: #fff8f0;
  border-bottom: 1rpx solid #f0e6da;
  flex-shrink: 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 0 0;
  position: relative;
}

.tab-text {
  font-size: 28rpx;
  color: #a09080;
  transition: color 0.25s;
}

.tab-item.active .tab-text {
  color: #6d4f3e;
  font-weight: 600;
}

.tab-indicator {
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #c8956c, #a07050);
  border-radius: 3rpx;
  margin-top: 12rpx;
}

/* ==================== 内容滑动区 ==================== */

.content-swiper {
  flex: 1;
  overflow: hidden;
}

.tab-content {
  height: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.content-hero {
  width: 100%;
  height: 390rpx;
  border-radius: 20rpx;
  margin-top: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
  object-fit: cover;
}

/* ==================== 内容卡片 ==================== */

.content-card {
  width: 100%;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 28rpx 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.card-label {
  font-size: 22rpx;
  color: #b8956e;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  display: block;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4a3628;
  margin-bottom: 14rpx;
  display: block;
  letter-spacing: 2rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #8c7a68;
  line-height: 1.8;
  display: block;
}

.spacer {
  height: 20rpx;
}

/* ==================== 底部标语 ==================== */

.brand-footer {
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  background-color: #fff8f0;
}

.footer-main {
  font-size: 26rpx;
  color: #6d4f3e;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: #a07f68;
  letter-spacing: 2rpx;
}