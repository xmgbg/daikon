.settings-container {
  min-height: 100vh;
  background-color: #f8f5f0;
  padding: 24rpx 28rpx 80rpx;
}

/* ==================== 菜单卡片 ==================== */

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-title {
  font-size: 24rpx;
  color: #bbb;
  padding: 24rpx 0 14rpx;
  letter-spacing: 2rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
}

.menu-text {
  font-size: 28rpx;
  color: #3d3d3d;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-value {
  font-size: 24rpx;
  color: #bbb;
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ddd;
  font-weight: 200;
}

.menu-switch {
  transform: scale(0.85);
}

.menu-divider {
  height: 1rpx;
  background: #f5f0eb;
}

/* ==================== 底部 ==================== */

.version-footer {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 22rpx;
  color: #c0b0a0;
}