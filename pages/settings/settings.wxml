<view class="settings-container">
  <!-- 通用设置 -->
  <view class="menu-card">
    <view class="menu-title">通用</view>
    <view class="menu-item" bindtap="toggleNotification">
      <text class="menu-text">消息通知</text>
      <switch class="menu-switch" checked="{{notificationEnabled}}" color="#ff6b35" bindchange="toggleNotification"></switch>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-text">清除缓存</text>
      <view class="menu-right">
        <text class="menu-value">{{cacheSize}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="checkUpdate">
      <text class="menu-text">检查更新</text>
      <view class="menu-right">
        <text class="menu-value">{{updateText}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="menu-card">
    <view class="menu-title">关于</view>
    <view class="menu-item" bindtap="showUserAgreement">
      <text class="menu-text">用户协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="showPrivacyPolicy">
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item">
      <text class="menu-text">当前版本</text>
      <text class="menu-value">v1.0.0</text>
    </view>
  </view>

  <view class="version-footer">
    <text class="footer-text">© 2026 包萝万象团队</text>
  </view>
</view>