/* ==================== 容器 ==================== */

.diy-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9f0 0%, #fff5e6 40%, #ffe8d6 100%);
  padding-bottom: 140rpx;
  position: relative;
  overflow-y: auto;
  overflow-x: hidden;
}

/* ==================== 背景装饰 ==================== */

.bg-deco {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
}

.dc-1 {
  width: 520rpx;
  height: 520rpx;
  top: -120rpx;
  right: -180rpx;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.07) 0%, transparent 70%);
  animation: floatCircle 8s ease-in-out infinite;
}

.dc-2 {
  width: 360rpx;
  height: 360rpx;
  bottom: 300rpx;
  left: -120rpx;
  background: radial-gradient(circle, rgba(255, 140, 66, 0.06) 0%, transparent 70%);
  animation: floatCircle 6s ease-in-out infinite reverse;
}

@keyframes floatCircle {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-24rpx) scale(1.04);
  }
}

/* ==================== 产品展示区 ==================== */

.product-showcase {
  width: 92%;
  height: 520rpx;
  margin: 60rpx auto 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.10);
  position: relative;
  z-index: 10;
}

.product-image {
  width: 100%;
  height: 100%;
  display: block;
}

.product-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, transparent 100%);
}

.product-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.product-tag {
  display: inline-block;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.product-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 8rpx;
}

.product-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* ==================== 区块通用样式 ==================== */

.section-block {
  width: 92%;
  margin: 40rpx auto 0;
  position: relative;
  z-index: 10;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.header-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #ff6b35 50%, transparent 100%);
  max-width: 120rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D4F3E;
  margin: 0 24rpx;
  letter-spacing: 4rpx;
}

/* ==================== 产品介绍 ==================== */

.intro-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.intro-text {
  font-size: 28rpx;
  color: #5a4a3a;
  line-height: 1.8;
  text-align: justify;
  text-indent: 2em;
  display: block;
  margin-bottom: 24rpx;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.feature-tag {
  background: linear-gradient(135deg, #fff5e6, #ffe8d6);
  border: 1rpx solid rgba(255, 107, 53, 0.2);
  color: #ff6b35;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* ==================== 使用步骤 ==================== */

.steps-list {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.step-item {
  display: flex;
  align-items: flex-start;
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx dashed #f0e0d0;
}

.step-item:last-child {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #6a5a4a;
  line-height: 1.6;
}

/* ==================== 保存小贴士 ==================== */

.tips-card {
  background: linear-gradient(135deg, #fff5e6, #ffe8d6);
  border: 1rpx solid rgba(255, 107, 53, 0.2);
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tips-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 28rpx;
  color: #5a4a3a;
  line-height: 1.6;
}

/* ==================== 视频教程 ==================== */

.video-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.video-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
}

.video-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 55%;
  transform: translate(-50%, -50%);
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #fff;
}

.video-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.video-title {
  font-size: 28rpx;
  color: #2c2c2c;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.video-douyin {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.douyin-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFD700;
  border-radius: 30rpx;
  padding: 6rpx 16rpx;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.copy-btn:active {
  transform: scale(0.95);
}

.copy-icon {
  font-size: 24rpx;
}

.copy-text {
  font-size: 22rpx;
  color: #6D4F3E;
  font-weight: 600;
}
