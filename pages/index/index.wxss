/* ==================== 容器 ==================== */

.home-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9f0 0%, #fff5e6 40%, #ffe8d6 100%);
  padding-bottom: 140rpx;
  position: relative;
  overflow-y: auto;
}

/* ==================== 背景装饰 ==================== */

.bg-deco {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.07) 0%, transparent 70%);
}

.dc-1 {
  width: 520rpx;
  height: 520rpx;
  top: -120rpx;
  right: -180rpx;
  animation: floatCircle 8s ease-in-out infinite;
}

.dc-2 {
  width: 360rpx;
  height: 360rpx;
  bottom: 300rpx;
  left: -120rpx;
  animation: floatCircle 6s ease-in-out infinite reverse;
}

.dc-3 {
  width: 280rpx;
  height: 280rpx;
  top: 45%;
  right: -80rpx;
  animation: floatCircle 10s ease-in-out infinite;
  background: radial-gradient(circle, rgba(255, 140, 66, 0.06) 0%, transparent 70%);
}

@keyframes floatCircle {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-24rpx) scale(1.04);
  }
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}

/* ==================== 头部 ==================== */

.header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 50rpx 30rpx 30rpx;
  position: relative;
  z-index: 10;
}

.logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.22);
  animation: breathe 3s ease-in-out infinite;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 24rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #2c2c2c;
  letter-spacing: 8rpx;
  line-height: 1.2;
}

.brand-tagline {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b0a090;
  letter-spacing: 4rpx;
}

/* ==================== 轮播图 ==================== */

.carousel {
  width: 92%;
  height: 520rpx;
  margin: 24rpx auto 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.10);
  position: relative;
  z-index: 10;
}

.carousel-slide {
  width: 100%;
  height: 100%;
  position: relative;
}

.carousel-image {
  width: 100%;
  height: 100%;
}

.carousel-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 220rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, transparent 100%);
}

.carousel-text {
  position: absolute;
  bottom: 44rpx;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
}

.carousel-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.carousel-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 3rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* ==================== 快速入口 ==================== */

.quick-nav {
  display: flex;
  justify-content: space-around;
  padding: 44rpx 20rpx 30rpx;
  position: relative;
  z-index: 10;
}

.nav-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s;
}

.nav-entry:active {
  transform: scale(0.9);
}

.nav-icon-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.28);
  margin-bottom: 14rpx;
  transition: box-shadow 0.2s;
}

.nav-entry:active .nav-icon-circle {
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.35);
}

.nav-icon-char {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.nav-label {
  font-size: 24rpx;
  color: #888;
  letter-spacing: 2rpx;
}

/* ==================== 精选产品标题 ==================== */

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx 30rpx 32rpx;
}

.section-line {
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e6bba0, transparent);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3d3d3d;
  margin: 0 28rpx;
  letter-spacing: 6rpx;
}

/* ==================== 产品卡片 ==================== */

.products-list {
  padding: 0 24rpx;
}

.product-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.product-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.product-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #faf6f0;
}

.product-info {
  flex: 1;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  font-size: 24rpx;
  color: #aaa;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-arrow {
  font-size: 44rpx;
  color: #ddd;
  margin-left: 10rpx;
  font-weight: 200;
  flex-shrink: 0;
}

.hot-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 0 20rpx 0 18rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 53, 0.2);
}

/* ==================== 底部标语 ==================== */

.slogan-section {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 56rpx 30rpx 30rpx;
}

.slogan-divider {
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4b8a0, transparent);
}

.slogan-text {
  font-size: 26rpx;
  color: #bfa082;
  margin: 0 26rpx;
  letter-spacing: 5rpx;
  white-space: nowrap;
}

/* ==================== 抖音购买引导 ==================== */

.douyin-section {
  padding: 0 30rpx 40rpx;
}

.douyin-card {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.douyin-icon {
  display: none;
}

.douyin-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.douyin-title {
  font-size: 32rpx;
  color: #6D4F3E;
  font-weight: 600;
  margin-bottom: 20rpx;
  text-align: center;
}

.douyin-desc {
  display: none;
}

.douyin-id-box {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.douyin-id {
  font-size: 28rpx;
  color: #6D4F3E;
  font-weight: 600;
}

.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFD700;
  border-radius: 30rpx;
  padding: 6rpx 16rpx;
  gap: 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
  border: none;
  line-height: 1.5;
  margin: 0;
  transition: all 0.2s;
}

.copy-btn:active {
  transform: scale(0.95);
}

.copy-btn-text {
  font-size: 22rpx;
  color: #6D4F3E;
  font-weight: 600;
}