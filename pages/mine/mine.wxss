/* ==================== 容器 & 背景 ==================== */

.mine-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff9f0 0%, #fff5e6 40%, #ffe8d6 100%);
  padding: 40rpx 28rpx 140rpx;
  position: relative;
  overflow-x: hidden;
}

.bg-deco {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 107, 53, 0.07) 0%, transparent 70%);
}

.dc-1 {
  width: 480rpx;
  height: 480rpx;
  top: -100rpx;
  right: -160rpx;
  animation: floatCircle 8s ease-in-out infinite;
}

.dc-2 {
  width: 320rpx;
  height: 320rpx;
  bottom: 200rpx;
  left: -100rpx;
  animation: floatCircle 7s ease-in-out infinite reverse;
}

@keyframes floatCircle {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.04);
  }
}

/* ==================== 信息卡片 ==================== */

.info-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 10;
}

.info-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.18);
}

.info-text {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.info-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 8rpx;
}

.info-desc {
  font-size: 24rpx;
  color: #aaa;
}

.info-arrow {
  font-size: 40rpx;
  color: #ddd;
  font-weight: 200;
  flex-shrink: 0;
}

/* ==================== 菜单卡片 ==================== */

.menu-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 10;
  overflow: hidden;
}

.menu-title {
  font-size: 24rpx;
  color: #bbb;
  padding: 24rpx 0 14rpx;
  letter-spacing: 2rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.menu-icon {
  font-size: 36rpx;
  width: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #3d3d3d;
  margin-left: 14rpx;
}

.menu-value {
  font-size: 24rpx;
  color: #bbb;
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ddd;
  font-weight: 200;
  flex-shrink: 0;
}

.menu-divider {
  height: 1rpx;
  background: #f5f0eb;
  margin-left: 66rpx;
}

/* ==================== 底部版本 ==================== */

.version-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 20rpx;
  position: relative;
  z-index: 10;
}

.version-text {
  font-size: 22rpx;
  color: #c0b0a0;
  margin-bottom: 8rpx;
}

.copyright-text {
  font-size: 20rpx;
  color: #d0c8c0;
}