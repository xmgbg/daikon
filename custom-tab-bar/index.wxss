.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 20rpx rgba(255, 107, 53, 0.1);
  z-index: 100;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-bar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-bar-label {
  font-size: 24rpx;
  font-weight: 600;
  font-family: 'Source Han Sans CN', 'Source Han Sans', 'Noto Sans CJK SC', sans-serif;
  transition: transform 0.3s;
}

.tab-bar-label.active {
  font-family: 'Microsoft YaHei', '微软雅黑', sans-serif;
  text-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.3);
  animation: breathe 2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
}

.tab-bar-center {
  position: relative;
}

.tab-bar-circle {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: -48rpx;
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.tab-bar-circle-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
