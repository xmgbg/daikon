.bottom-nav {
  display: flex;
  align-items: stretch;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(255, 107, 53, 0.1);
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-label {
  font-size: 28rpx;
  color: #999;
  transition: color 0.2s;
}

.nav-active .nav-label {
  color: #ff6b35;
  font-weight: 600;
}

/* 中间圆形按钮 */
.nav-circle {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: -48rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 102;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.nav-circle:active {
  transform: translateX(-50%) scale(0.95);
}

.nav-circle-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
